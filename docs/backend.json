
{
  "entities": {
    "UserProfile": {
      "title": "Perfil de Usuario",
      "description": "Datos de perfil extendidos guardados en Firestore, incluyendo el DNI, Licencias y Economía.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "empresaId": { "type": "string", "nullable": true },
        "doblones": { "type": "number" },
        "shipStatus": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "wallet": {
          "type": "object",
          "properties": {
            "balance": { "type": "number" },
            "bankBalance": { "type": "number" },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        },
        "dni": {
          "type": "object",
          "properties": {
            "nombre": { "type": "string" },
            "apellidos": { "type": "string" },
            "fechaNacimiento": { "type": "string" },
            "imageUrl": { "type": "string" },
            "estado": { "type": "string", "enum": ["pendiente", "aprobado", "rechazado"] },
            "razonRechazo": { "type": "string", "nullable": true },
            "solicitadoEn": { "type": "string", "format": "date-time" }
          }
        },
        "licencia_conducir": { "$ref": "#/backend/entities/License" },
        "licencia_armas": { "$ref": "#/backend/entities/License" },
        "licencia_navegar": { "$ref": "#/backend/entities/License" }
      },
      "required": ["id", "username"]
    },
    "Company": {
      "title": "Empresa",
      "description": "Datos de una empresa u organización.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "ownerId": { "type": "string" },
        "tipo": { "type": "string" },
        "nivel": { "type": "number" },
        "empleadosCapacity": { "type": "number" },
        "empleados": { "type": "array", "items": { "type": "string" } },
        "actividadRegistrada": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nombre", "ownerId", "tipo"]
    },
    "License": {
      "title": "Licencia",
      "description": "Documento que habilita una actividad específica.",
      "type": "object",
      "properties": {
        "tipo": { "type": "string" },
        "puntos": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time", "nullable": true },
        "createdAt": { "type": "string", "format": "date-time" },
        "suspendidaHasta": { "type": "string", "format": "date-time", "nullable": true }
      }
    },
    "Warn": {
      "title": "Advertencia",
      "description": "Sanción aplicada a un usuario por moderación.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moderador": { "type": "string" },
        "razon": { "type": "string" },
        "fecha": { "type": "string" },
        "apelada": { "type": "boolean" },
        "apelaRazon": { "type": "string", "nullable": true }
      },
      "required": ["id", "moderador", "razon", "fecha", "apelada"]
    },
    "Antecedent": {
      "title": "Antecedente Policial",
      "description": "Registro de arresto o multa de un usuario.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipo": { "type": "string", "enum": ["arresto", "multa"] },
        "razon": { "type": "string" },
        "imageUrl": { "type": "string", "nullable": true },
        "fechaRegistro": { "type": "string" },
        "retirado": { "type": "boolean" }
      },
      "required": ["id", "tipo", "razon", "fechaRegistro", "retirado"]
    }
  },
  "auth": {
    "providers": ["discord"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Datos de usuario persistidos en Firestore."
    },
    "/users/{userId}/warns/{warnId}": {
      "schema": { "$ref": "#/backend/entities/Warn" },
      "description": "Lista de advertencias del usuario."
    },
    "/users/{userId}/antecedentes/{antecedentId}": {
      "schema": { "$ref": "#/backend/entities/Antecedent" },
      "description": "Lista de antecedentes policiales del usuario."
    },
    "/empresas/{companyId}": {
      "schema": { "$ref": "#/backend/entities/Company" },
      "description": "Datos de empresas en la ciudad."
    }
  }
}
