{
  "entities": {
    "UserProfile": {
      "title": "Perfil de Usuario",
      "description": "Datos de perfil extendidos guardados en Firestore, incluyendo el DNI.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "doblones": { "type": "number" },
        "shipStatus": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "dni": {
          "type": "object",
          "properties": {
            "nombre": { "type": "string" },
            "apellidos": { "type": "string" },
            "fechaNacimiento": { "type": "string" },
            "imageUrl": { "type": "string" },
            "estado": { "type": "string", "enum": ["pendiente", "aprobado", "rechazado"] },
            "razonRechazo": { "type": "string", "nullable": true },
            "solicitadoEn": { "type": "string", "format": "date-time" }
          }
        }
      },
      "required": ["id", "username"]
    },
    "Warn": {
      "title": "Advertencia",
      "description": "Sanción aplicada a un usuario por moderación.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moderador": { "type": "string" },
        "razon": { "type": "string" },
        "fecha": { "type": "string" },
        "apelada": { "type": "boolean" },
        "apelaRazon": { "type": "string", "nullable": true }
      },
      "required": ["id", "moderador", "razon", "fecha", "apelada"]
    }
  },
  "auth": {
    "providers": ["discord"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Datos de usuario persistidos en Firestore."
    },
    "/users/{userId}/warns/{warnId}": {
      "schema": { "$ref": "#/backend/entities/Warn" },
      "description": "Lista de advertencias del usuario."
    }
  }
}