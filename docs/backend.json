
{
  "entities": {
    "User": {
      "title": "Perfil de Usuario",
      "description": "Información del usuario y estado en la radio",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "radio": {
          "type": "object",
          "properties": {
            "placa": { "type": "string" },
            "canalActual": { "type": "string" },
            "isTransmitting": { "type": "boolean" },
            "isOperator": { "type": "boolean" },
            "isCitizen": { "type": "boolean" },
            "ultimaConexion": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "EmergencyCall": {
      "title": "Llamada de Emergencia",
      "description": "Registro de avisos del 112",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "ubicacion": { "type": "string" },
        "motivo": { "type": "string" },
        "unidades": { "type": "array", "items": { "type": "string" } },
        "estado": { "type": "string", "enum": ["En proceso", "Codigo 4", "Cancelado"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "audioGenerated": { "type": "boolean" }
      }
    },
    "ErlcEvent": {
      "title": "Evento ERLC",
      "description": "Evento externo recibido desde el servidor de juego",
      "type": "object",
      "properties": {
        "tipo": { "type": "string", "enum": ["PANICO", "ALERTA", "INFO"] },
        "sujeto": { "type": "string" },
        "ubicacion": { "type": "string" },
        "detalles": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["discord"]
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Datos de perfil y estado de radio"
    },
    "emergencyCalls/{callId}": {
      "schema": "EmergencyCall",
      "description": "Registro de incidentes activos"
    },
    "erlcEvents/{eventId}": {
      "schema": "ErlcEvent",
      "description": "Logs de eventos recibidos por API externa"
    }
  }
}
