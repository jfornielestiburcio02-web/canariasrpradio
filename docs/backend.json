
{
  "entities": {
    "UserProfile": {
      "title": "Perfil de Usuario",
      "description": "Datos de perfil extendidos guardados en Firestore, incluyendo el DNI, Licencias y Economía.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "empresaId": { "type": "string", "nullable": true },
        "wallet": {
          "type": "object",
          "properties": {
            "balance": { "type": "number" },
            "bankBalance": { "type": "number" },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        },
        "dni": {
          "type": "object",
          "properties": {
            "nombre": { "type": "string" },
            "apellidos": { "type": "string" },
            "fechaNacimiento": { "type": "string" },
            "imageUrl": { "type": "string" },
            "estado": { "type": "string", "enum": ["pendiente", "aprobado", "rechazado"] },
            "razonRechazo": { "type": "string", "nullable": true },
            "solicitadoEn": { "type": "string", "format": "date-time" }
          }
        },
        "fichamedica": {
          "type": "object",
          "properties": {
            "informacion": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" }
          }
        }
      },
      "required": ["id", "username"]
    },
    "Company": {
      "title": "Empresa",
      "description": "Datos de una empresa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "ownerId": { "type": "string" },
        "tipo": { "type": "string" },
        "nivel": { "type": "number" },
        "empleadosCapacity": { "type": "number" },
        "empleados": { "type": "array", "items": { "type": "string" } },
        "actividadRegistrada": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "ownerId"]
    },
    "Loan": {
      "title": "Préstamo",
      "description": "Registro de un préstamo bancario para una empresa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "totalWithInterest": { "type": "number" },
        "monthlyPayment": { "type": "number" },
        "months": { "type": "number" },
        "paid": { "type": "number" },
        "status": { "type": "string", "enum": ["pendiente", "aprobado", "pagado"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Invoice": {
      "title": "Factura",
      "description": "Registro de una factura entre ciudadanos o empresas.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "issuerId": { "type": "string" },
        "receiverId": { "type": "string" },
        "amount": { "type": "number" },
        "concepto": { "type": "string" },
        "estado": { "type": "string", "enum": ["pendiente", "pagado", "anulado"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Transaction": {
      "title": "Transacción",
      "description": "Registro de un movimiento económico en la cuenta del usuario.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "tipo": { "type": "string" },
        "descripcion": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["discord"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Datos de usuario persistidos en Firestore."
    },
    "/users/{userId}/transacciones/{transId}": {
      "schema": { "$ref": "#/backend/entities/Transaction" },
      "description": "Historial de movimientos económicos del usuario."
    },
    "/empresas/{companyId}": {
      "schema": { "$ref": "#/backend/entities/Company" },
      "description": "Colección global de empresas."
    },
    "/empresas/{companyId}/loans/{loanId}": {
      "schema": { "$ref": "#/backend/entities/Loan" },
      "description": "Préstamos asociados a una empresa específica."
    },
    "/facturas/{invoiceId}": {
      "schema": { "$ref": "#/backend/entities/Invoice" },
      "description": "Colección global de facturas entre usuarios."
    }
  }
}
